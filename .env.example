PORT=3000
NODE_ENV=development

##Database configuration
# For running `prisma` commands from the host (outside Docker).
# Matches docker-compose's postgres service, via the host-mapped port (5431 -> 5432).
DATABASE_URL=postgresql://user:password@localhost/dbname

## JWT configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=8h

## RabbitMQ configuration
# RABBITMQ_USER/RABBITMQ_PASSWORD are read by docker-compose.yml to set up the
# rabbitmq service itself; RABBITMQ_URL is what the API/worker use to connect to it.
# These are local dev-only credentials on an isolated docker network, not real secrets.
RABBITMQ_USER=preordersystem
RABBITMQ_PASSWORD=posrabbitmq
# Via Docker (matches docker-compose's rabbitmq service hostname):
RABBITMQ_URL=amqp://preordersystem:posrabbitmq@localhost:5672

## CORS configuration
# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

## Stripe configuration (optional — payment routes are disabled without these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

## DeepL configuration (optional — menu translation is disabled without these)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2